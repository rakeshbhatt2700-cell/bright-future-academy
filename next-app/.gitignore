:root {
  --navy: #10233f;
  --blue: #2563eb;
  --sky: #eaf2ff;
  --gold: #f5b82e;
  --ink: #182230;
  --muted: #667085;
  --bg: #f7f9fc;
  --line: #e7ebf2;
  --shadow: 0 16px 40px rgba(16, 35, 63, 0.1);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  color: var(--ink);
  background: var(--bg);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  max-width: 100%;
}

.container {
  width: min(1120px, 92%);
  margin: auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.94);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(12px);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 800;
}

.brand strong {
  display: block;
}

.brand small {
  display: block;
  color: var(--muted);
  font-size: 11px;
  font-weight: 600;
}

.logo {
  width: 44px;
  height: 44px;
  background: linear-gradient(135deg, var(--blue), var(--navy));
  border-radius: 13px;
  color: white;
  display: grid;
  place-items: center;
  font-size: 22px;
  font-weight: 800;
}

.nav-links {
  display: flex;
  gap: 20px;
  align-items: center;
  font-size: 14px;
  font-weight: 650;
}

.nav-links a:hover {
  color: var(--blue);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  padding: 13px 19px;
  border-radius: 12px;
  font-weight: 750;
  cursor: pointer;
  transition: 0.2s;
}

.btn-primary {
  background: var(--blue);
  color: white;
  box-shadow: 0 9px 22px rgba(37, 99, 235, 0.22);
}

.btn-primary:hover {
  transform: translateY(-2px);
  background: #1d4ed8;
}

.btn-outline {
  border: 1px solid #cfd8e7;
  background: #fff;
  color: var(--navy);
}

.hero {
  padding: 76px 0 62px;
  background: radial-gradient(circle at 85% 15%, #dbeafe 0, transparent 32%), linear-gradient(180deg, #fff 0%, #f7f9fc 100%);
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.08fr 0.92fr;
  align-items: center;
  gap: 52px;
}

.eyebrow {
  display: inline-flex;
  padding: 7px 11px;
  border-radius: 999px;
  background: var(--sky);
  color: #1d4ed8;
  font-size: 13px;
  font-weight: 800;
  margin-bottom: 18px;
}

h1 {
  font-size: clamp(40px, 5.4vw, 68px);
  line-height: 1.03;
  color: var(--navy);
}

h1 span {
  color: var(--blue);
}

.hero-copy {
  max-width: 640px;
  color: var(--muted);
  font-size: 18px;
  margin: 20px 0 28px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.rating {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 28px;
  color: var(--muted);
}

.stars {
  color: var(--gold);
  font-size: 20px;
}

.hero-card {
  position: relative;
  overflow: hidden;
  background: var(--navy);
  border-radius: 28px;
  padding: 30px;
  color: white;
  box-shadow: var(--shadow);
}

.hero-card:after {
  content: '';
  position: absolute;
  width: 190px;
  height: 190px;
  border-radius: 50%;
  right: -80px;
  top: -80px;
  background: rgba(37, 99, 235, 0.42);
}

.hero-card h2 {
  position: relative;
  z-index: 1;
  margin-bottom: 8px;
  font-size: 23px;
}

.hero-card > p {
  position: relative;
  z-index: 1;
  color: #cbd5e1;
  margin-bottom: 24px;
}

.mini-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  position: relative;
  z-index: 1;
}

.mini {
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, 0.13);
  background: rgba(255, 255, 255, 0.06);
  border-radius: 16px;
}

.mini b {
  display: block;
  font-size: 23px;
}

.mini span {
  color: #cbd5e1;
  font-size: 12px;
}

.hero-card-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 18px;
  position: relative;
  z-index: 1;
}

.showcase {
  background: #fff;
  border-top: 1px solid var(--line);
}

.showcase-grid {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 24px;
}

.logo-panel,
.review-visual {
  background: linear-gradient(145deg, #f8fbff, #eef5ff);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 26px;
}

.logo-lockup {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 20px;
  border-radius: 18px;
  background: linear-gradient(135deg, #10233f, #2563eb);
  color: #fff;
}

.logo-mark {
  width: 58px;
  height: 58px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.14);
  display: grid;
  place-items: center;
  font-size: 28px;
  font-weight: 900;
}

.logo-text strong {
  display: block;
  font-size: 20px;
}

.logo-text small {
  display: block;
  text-transform: uppercase;
}

.section-head {
  max-width: 680px;
  margin-bottom: 34px;
}

.tag {
  color: var(--blue);
  font-size: 13px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 1.2px;
}

.section-head h2 {
  font-size: clamp(30px, 4vw, 44px);
  line-height: 1.1;
  color: var(--navy);
  margin: 8px 0 12px;
}

.section-head p {
  color: var(--muted);
}

.cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 26px;
  box-shadow: 0 8px 26px rgba(16, 35, 63, 0.05);
}

.icon {
  width: 46px;
  height: 46px;
  border-radius: 14px;
  background: var(--sky);
  display: grid;
  place-items: center;
  font-size: 22px;
  margin-bottom: 17px;
}

.card h3 {
  color: var(--navy);
  margin-bottom: 7px;
}

.card p {
  color: var(--muted);
  font-size: 14px;
}

.apply {
  background: var(--navy);
  color: #fff;
}

.apply-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 45px;
  align-items: center;
}

.apply .section-head h2,
.apply .section-head p {
  color: #fff;
}

.contact-box {
  display: grid;
  gap: 12px;
  margin-top: 25px;
}

.contact-box a {
  color: #dbeafe;
}

.apply-panel {
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.16);
  border-radius: 22px;
  padding: 30px;
}

.apply-panel h3 {
  font-size: 22px;
  margin-bottom: 8px;
}

.apply-panel p {
  color: #cbd5e1;
  margin-bottom: 20px;
}

.location {
  background: #fff;
}

.location-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
}

.map-embed {
  min-height: 300px;
  border: 1px solid var(--line);
  border-radius: 20px;
  overflow: hidden;
  background: #eef2f7;
}

.map-embed iframe {
  display: block;
  width: 100%;
  height: 300px;
  border: 0;
}

@media (max-width: 820px) {
  .nav-links {
    display: none;
  }

  .hero-grid,
  .showcase-grid,
  .apply-grid,
  .location-grid {
    grid-template-columns: 1fr;
  }

  .cards {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .hero-actions .btn,
  .hero-card-actions .btn {
    width: 100%;
  }
}
